#!/usr/bin/env bash
# Prints Orca's version-matched orchestration guide as session-start context
# for a coding agent launched inside an Orca-managed terminal, or nothing.
#
#   orca-orchestration-context --harness claude --part N
#   orca-orchestration-context --harness antigravity
#
# Claude Code caps each hook's output at 10,000 characters and replaces a
# longer one with a file path and a short preview, so the guide is split on
# line boundaries into labeled parts and each hook handler prints one of them.
# The last part either harness receives ends with a note that Orca workers
# replace the harness's own subagents, then a note on closing a worker
# terminal that release keeps because the user opened it; for Claude Code a
# note on running Orca waits in the background follows them. Antigravity gets
# every part in order as one injectSteps document.
#
# The hook must never stand between the user and a session: every path out of
# this script exits 0, and anything short of a complete guide prints nothing.
# The Nix package replaces the @...@ constants with store paths, because a hook
# runs with whatever PATH the agent was started with.
set -uo pipefail

ORCA_CLI='@ORCA_CLI@'
JQ='@JQ@'
TIMEOUT='@TIMEOUT@'
# The pinned CLI is a bash script that calls coreutils from PATH, and a hook
# inherits whatever PATH the agent was started with.
CLI_PATH='@CLI_PATH@'

# Bytes rather than characters, so a multibyte guide still fits the cap. The
# last Claude part also carries the overflow line and all three notes, about
# 2,000 bytes, which a full part must leave room for.
PART_BYTES=7500
# The number of handlers hooks/hooks.json declares for Claude Code; the
# package substitutes the same value the plugin builds its handlers from.
CLAUDE_PARTS='@CLAUDE_PARTS@'
GUIDE_TIMEOUT=5

# Claude Code's Bash tool stops a foreground command at 10 minutes, under the
# guide's 15-minute waits, and holds the session while it runs. The note
# follows the last part Claude Code receives, after the guide it amends.
CLAUDE_WAIT_NOTE="Claude Code: run every Orca command that waits on an agent, such as \`orchestration check --wait\` or \`terminal wait\`, with the Bash tool's \`run_in_background\` option, never in the foreground. A foreground Bash command stops at 10 minutes, before the guide's 15-minute waits expire, and blocks the session while it runs. A background command re-invokes you when it exits, so do not poll it with sleep; read its output then and handle the result as the guide describes."

# The subagent guard refuses the harness's own subagents in these sessions,
# and skills fall back to inline work when subagents are unavailable, while
# the guide reserves the coordinator role for an explicit request to
# supervise. Agents then do delegated work inline, so the standing rule says
# Orca workers replace those subagents. Harness-neutral: both harnesses are
# guarded.
DELEGATION_NOTE="Orca subagents: this session refuses the harness's own subagent tools, and Orca workers take their place. Whenever a skill, prompt, or plan calls for subagents (reviewers, researchers, scouts, parallel dispatch), that is a request to supervise: start one worker per subagent with \`ORCA orchestration worker-start --spec \"<its full prompt>\"\` and use each \`worker_done\` report as its result, however small the work. A fallback to inline or serial work when subagents are unavailable never applies here. Only if worker-start refuses because this session is at Orca's nesting depth limit, do that work in this session; for any other Orca failure, report its error and stop."

# Opening a worker's tab in Orca marks its terminal as taken over by the user,
# and worker-release then keeps the terminal open, so the guide's cleanup
# never closes it. Harness-neutral: both harnesses receive it.
TAKEOVER_NOTE="Orca worker cleanup: when \`worker-release\` on a Dispatch whose \`worker_done\` you accepted reports \`state: retained\` with \`reason: user_takeover\` (opening a worker's tab is enough to cause it), run \`ORCA orchestration worker-read --dispatch <dispatch_id>\` once to keep its output, then close that worker's agent terminal, the \`kind: terminal\`, \`role: agent\` handle in its \`worker-start\` receipt, with \`ORCA terminal close --terminal <handle>\`. This is the one case where closing replaces release; any other retained reason, \`release_unknown\`, and every terminal worker-start did not create keep the guide's rules."

harness=
part=
while [[ $# -gt 0 ]]; do
  case $1 in
    --harness) harness=${2:-}; shift 2 || exit 0 ;;
    --part) part=${2:-}; shift 2 || exit 0 ;;
    *) exit 0 ;;
  esac
done

case $harness in
  claude) [[ $part =~ ^[1-9][0-9]*$ ]] || exit 0 ;;
  antigravity) [[ -z $part ]] || exit 0 ;;
  *) exit 0 ;;
esac

# Orca sets ORCA_PANE_KEY in every terminal it manages and in every agent it
# launches; its own agent hook gates on the same variable. Empty is absent.
[[ -n ${ORCA_PANE_KEY:-} ]] || exit 0

# The order the orchestration skill documents. The pinned CLI is the extracted
# AppImage's Node-mode entry point that Orca's own shim runs; a bare `orca` on
# PATH can be the GNOME screen reader.
if [[ -n ${ORCA_CLI_COMMAND:-} ]]; then
  cli=$ORCA_CLI_COMMAND
elif [[ -n ${ORCA_DEV_REPO_ROOT:-} ]]; then
  cli=$(command -v orca-dev) || exit 0
else
  cli=$ORCA_CLI
  PATH=$CLI_PATH${PATH:+:$PATH}
fi

guide=$("$TIMEOUT" "$GUIDE_TIMEOUT" "$cli" skills get orchestration </dev/null 2>/dev/null) || exit 0
[[ -n ${guide//[[:space:]]/} ]] || exit 0

export LC_ALL=C
# `open` tracks whether `current` holds lines, since a blank guide line makes
# an open part look empty. Parts rejoined with newlines reproduce the guide.
parts=()
current=
open=
# A single line longer than a part is cut into part-sized pieces, each its own
# part; that is the one case where rejoining with newlines is not exact.
while IFS= read -r line; do
  while ((${#line} > PART_BYTES)); do
    [[ -z $open ]] || parts+=("$current")
    parts+=("${line:0:PART_BYTES}")
    current=
    open=
    line=${line:PART_BYTES}
  done
  if [[ -z $open ]]; then
    current=$line
    open=1
  elif ((${#current} + 1 + ${#line} > PART_BYTES)); then
    parts+=("$current")
    current=$line
  else
    current+=$'\n'$line
  fi
done <<<"$guide"
[[ -z $open ]] || parts+=("$current")

total=${#parts[@]}
((total > 0)) || exit 0

render() {
  local index=$1
  printf 'Orca orchestration guide (injected at session start), part %d of %d\n\n%s' \
    "$index" "$total" "${parts[index - 1]}"
}

if [[ $harness == claude ]]; then
  ((part <= total)) || exit 0
  text=$(render "$part")
  if ((part == CLAUDE_PARTS && total > CLAUDE_PARTS)); then
    text+=$'\n\n'"The guide continues past this part. Run \`$cli skills get orchestration\` for the rest."
  fi
  if ((part == (total < CLAUDE_PARTS ? total : CLAUDE_PARTS))); then
    text+=$'\n\n'$DELEGATION_NOTE$'\n\n'$TAKEOVER_NOTE$'\n\n'$CLAUDE_WAIT_NOTE
  fi
  printf '%s\n' "$text"
  exit 0
fi

rendered=()
for ((index = 1; index <= total; index++)); do
  rendered+=("$(render "$index")")
done
rendered[total - 1]+=$'\n\n'$DELEGATION_NOTE$'\n\n'$TAKEOVER_NOTE
"$JQ" -cn '{injectSteps: [$ARGS.positional[] | {ephemeralMessage: .}]}' \
  --args "${rendered[@]}" 2>/dev/null || true
exit 0
