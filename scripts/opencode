#!/usr/bin/env bash
# Runs the pinned OpenCode with its API key and the switches that keep it from
# updating itself or loading anything a checkout or Claude Code supplies. The
# Nix package replaces the @...@ constants. Builtins only, so the wrapper needs
# nothing on PATH.
set -euo pipefail

TOKEN_FILE='@TOKEN_FILE@'
OPENCODE='@OPENCODE@'
RIPGREP_BIN='@RIPGREP_BIN@'

# A key the caller already exported wins, so another account can be tested
# without touching secrets. Anything wrong with the file means no key, and
# OpenCode runs on the free tier's anonymous limits: the file is absent on
# bootstrap generations, and saying nothing about it keeps every run quiet.
if [[ -z ${OPENCODE_API_KEY:-} ]]; then
  unset OPENCODE_API_KEY
  # A missing, unreadable, or directory path fails the read, which leaves
  # token empty.
  token=
  { IFS= read -r -d '' -N 16384 token <"$TOKEN_FILE"; } 2>/dev/null || true
  token=${token%"${token##*[![:space:]]}"}
  if [[ -n $token && ${#token} -le 8192 && $token != *[[:space:][:cntrl:]]* ]]; then
    export OPENCODE_API_KEY=$token
  fi
  unset token
fi

# The self-update switch holds under any config T3 Code supplies inline or
# through OPENCODE_CONFIG_DIR, which never see the declared autoupdate key.
# A process holding the key loads no project opencode.json or .opencode/
# directory, whose plugins and provider overrides are the reviewed checkout's
# code, and no Claude Code instructions or skills, so a review peer runs on its
# brief alone.
export OPENCODE_DISABLE_AUTOUPDATE=true
export OPENCODE_DISABLE_PROJECT_CONFIG=true
export OPENCODE_DISABLE_CLAUDE_CODE=true

# OpenCode downloads ripgrep into its data directory when none is on PATH.
export PATH="$RIPGREP_BIN${PATH:+:$PATH}"

exec "$OPENCODE" "$@"
