#!/usr/bin/env bash
# Lints the staged Markdown, not the working tree. When any Markdown is
# staged, the whole index is checked out into a scratch directory and bare
# markdownlint-cli2 runs there, so the result matches CI's markdown-lint check
# on this commit: same config globs, nested configs, and symlink targets.
# markdownlint-cli2 is usually a mise shim, and mise refuses the copy's
# mise.toml because nothing trusted that new path. MISE_TRUSTED_CONFIG_PATHS
# trusts the copy for this one command without writing a trust entry; pwd -P
# resolves it, since mise compares the resolved path (macOS $TMPDIR sits under
# /var, a link to /private/var).
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

if git diff --cached --quiet --diff-filter=ACMR -- '*.md'; then
  exit 0
fi

tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT

git checkout-index --all --prefix="$tmpdir/"

status=0
(cd "$tmpdir" && MISE_TRUSTED_CONFIG_PATHS="$(pwd -P)" markdownlint-cli2) || status=$?

if [[ $status -ne 0 ]]; then
  printf "To fix: mise exec -- markdownlint-cli2 --no-globs --fix <file> (skip with git commit --no-verify)\n" >&2
  exit "$status"
fi
