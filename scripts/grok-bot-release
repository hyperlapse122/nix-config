#!/usr/bin/env python3
"""Resolve the newest stable Grok Bot release for Linux from xAI's Cursor feed.

Queries the stable download endpoints for linux-x64 and linux-arm64, verifies
that both architectures agree on version and that each names its own versioned
.deb on the official Cursor download host, prefetches each .deb to capture its
sha256 SRI hash, and writes the packages/grok-bot-release.json pin file, or
prints it with --dry-run. Leaves the pin alone unless the feed is newer.
"""

import argparse
import concurrent.futures
import contextlib
import json
import os
import re
import shlex
import subprocess
import sys
import tempfile

# Nix system -> (feed and download directory architecture, Debian architecture).
PLATFORMS = {
    "x86_64-linux": ("x64", "amd64"),
    "aarch64-linux": ("arm64", "arm64"),
}
FEED_URL = "https://api2.cursor.sh/updates/api/download/stable/linux-{arch}/sand"

DEFAULT_FETCH = "curl -fsSL --max-time 60"
DEFAULT_PREFETCH = "nix store prefetch-file --json --hash-type sha256"
COMMAND_TIMEOUT = int(os.environ.get("GROK_BOT_RELEASE_TIMEOUT", "900"))

VERSION_PATTERN = re.compile(r"^\d+(?:\.\d+)*$")
SRI_PATTERN = re.compile(r"^sha256-[A-Za-z0-9+/]{43}=$")
ALLOWED_DEB_PREFIX = "https://downloads.cursor.com/grokbot/"
DEB_COMMIT_PATTERN = r"stable/[0-9a-f]+"


class Failure(Exception):
    pass


def run_command(env_name, default, url):
    """Run an overridable command with the URL appended and return its stdout."""
    command = shlex.split(os.environ.get(env_name, default))
    if not command:
        raise Failure(f"{env_name} is empty")
    try:
        proc = subprocess.run(
            command + [url],
            stdin=subprocess.DEVNULL,
            capture_output=True,
            text=True,
            timeout=COMMAND_TIMEOUT,
        )
    except subprocess.TimeoutExpired:
        raise Failure(f"{command[0]} for {url} timed out after {COMMAND_TIMEOUT}s") from None
    if proc.returncode != 0:
        raise Failure(f"{command[0]} for {url} failed with status {proc.returncode}")
    return proc.stdout


def fetch_feed(url):
    return run_command("GROK_BOT_RELEASE_FETCH", DEFAULT_FETCH, url)


def parse_feed_response(content, url, arch, deb_arch):
    try:
        data = json.loads(content)
    except ValueError as exc:
        raise Failure(f"feed for {url} returned invalid JSON: {exc}")
    if not isinstance(data, dict):
        raise Failure(f"feed for {url} returned unexpected response shape: {content.strip()!r}")

    version = data.get("version")
    deb_url = data.get("debUrl")
    if not isinstance(version, str) or not isinstance(deb_url, str):
        error_msg = data.get("error") or data.get("message")
        if error_msg:
            raise Failure(f"feed for {url} returned error: {error_msg}")
        raise Failure(f"feed for {url} returned no version or debUrl: {content.strip()!r}")

    if not VERSION_PATTERN.match(version):
        raise Failure(f"feed for {url} returned invalid version: {version!r}")
    expected = re.compile(
        re.escape(ALLOWED_DEB_PREFIX)
        + DEB_COMMIT_PATTERN
        + re.escape(f"/linux/{arch}/grok-bot_{version}_{deb_arch}.deb")
        + "$"
    )
    if not expected.match(deb_url):
        raise Failure(
            f"debUrl for {url} is not grok-bot_{version}_{deb_arch}.deb under "
            f"{ALLOWED_DEB_PREFIX}: {deb_url!r}"
        )
    return version, deb_url


def prefetch_deb(url):
    output = run_command("GROK_BOT_RELEASE_PREFETCH", DEFAULT_PREFETCH, url)
    try:
        sri = json.loads(output).get("hash")
    except (ValueError, AttributeError):
        sri = None
    if not isinstance(sri, str) or not SRI_PATTERN.match(sri):
        raise Failure(f"prefetch output for {url} carries no sha256 SRI hash: {output.strip()!r}")
    return sri


def version_tuple(version):
    if not isinstance(version, str) or not VERSION_PATTERN.match(version):
        raise ValueError(f"not a version string: {version!r}")
    return tuple(int(part) for part in version.split("."))


def pinned_version(path):
    if not path:
        return None
    try:
        with open(path, "r", encoding="utf-8") as f:
            data = json.load(f)
        if isinstance(data, dict):
            return data.get("version")
        return None
    except (OSError, ValueError):
        return None


def write_atomically(path, text):
    directory = os.path.dirname(os.path.abspath(path))
    fd, tmp = tempfile.mkstemp(dir=directory, prefix=".grok-bot-release.")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
        os.chmod(tmp, 0o644)
        os.replace(tmp, path)
    except BaseException:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(tmp)
        raise


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--output",
        "-o",
        help="Path to grok-bot-release.json to write or update",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Print resolved JSON to stdout without modifying files",
    )
    args = parser.parse_args(argv)

    try:
        feed_results = {}
        for platform, (arch, deb_arch) in PLATFORMS.items():
            url = FEED_URL.format(arch=arch)
            feed_results[platform] = parse_feed_response(fetch_feed(url), url, arch, deb_arch)

        versions = {found for found, _ in feed_results.values()}
        if len(versions) != 1:
            listing = ", ".join(f"{platform} has {found}" for platform, (found, _) in feed_results.items())
            raise Failure(f"architectures disagree on version: {listing}")
        (version,) = versions

        write = not args.dry_run and bool(args.output)
        if write:
            current_version = pinned_version(args.output)
            if current_version is not None:
                try:
                    is_newer = version_tuple(version) > version_tuple(current_version)
                except ValueError:
                    is_newer = True
                if not is_newer:
                    if version == current_version:
                        print(f"{args.output} is already up to date at version {current_version}")
                    else:
                        print(
                            f"{args.output} is already up to date at version {current_version} "
                            f"(feed {version} is older)"
                        )
                    return 0

        # The debs are prefetched together and read in PLATFORMS order, so a
        # refusal names the same package a serial prefetch would.
        with concurrent.futures.ThreadPoolExecutor() as pool:
            hashes = {
                platform: pool.submit(prefetch_deb, deb_url)
                for platform, (_, deb_url) in feed_results.items()
            }
            platforms = {
                platform: {"url": feed_results[platform][1], "hash": hashes[platform].result()}
                for platform in PLATFORMS
            }

        pin_data = {
            "version": version,
            "platforms": platforms,
        }
        out_json = json.dumps(pin_data, indent=2) + "\n"

        if not write:
            sys.stdout.write(out_json)
            return 0

        write_atomically(args.output, out_json)
        print(f"updated {args.output} to version {version}")
        return 0

    except (Failure, OSError) as exc:
        print(f"grok-bot-release: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
