#!/usr/bin/env python3
"""Resolve the newest stable Grok Bot release for Linux from xAI's Cursor feed.

Queries the stable download endpoints for linux-x64 and linux-arm64, verifies
that both architectures agree on version and provide valid .deb download URLs
under the official cursor download domain, prefetches each .deb to capture its
sha256 SRI hash, and writes or verifies the packages/grok-bot-release.json pin file.
Refuses to update if the feed version is not newer than the currently pinned version.
"""

import argparse
import json
import os
import re
import shlex
import subprocess
import sys
import tempfile

PLATFORMS = {
    "x86_64-linux": "https://api2.cursor.sh/updates/api/download/stable/linux-x64/sand",
    "aarch64-linux": "https://api2.cursor.sh/updates/api/download/stable/linux-arm64/sand",
}

DEFAULT_FETCH = "curl -s"
DEFAULT_PREFETCH = "nix store prefetch-file --json --hash-type sha256"
COMMAND_TIMEOUT = 900

VERSION_PATTERN = re.compile(r"^\d+(?:\.\d+)*$")
SRI_PATTERN = re.compile(r"^sha256-[A-Za-z0-9+/]{43}=$")
ALLOWED_DEB_PREFIX = "https://downloads.cursor.com/grokbot/"


class Failure(Exception):
    """A refusal that should stop the caller with a readable message."""


def run_command(env_name, default, url):
    """Run an overridable command with the URL appended and return its stdout.

    The commands are overridable so offline tests and sandboxed Nix checks can
    provide fixtures instead of network calls.
    """
    command = shlex.split(os.environ.get(env_name, default))
    if not command:
        raise Failure(f"{env_name} is empty")
    try:
        proc = subprocess.run(
            command + [url],
            stdin=subprocess.DEVNULL,
            capture_output=True,
            text=True,
            timeout=COMMAND_TIMEOUT,
        )
    except subprocess.TimeoutExpired:
        raise Failure(f"{command[0]} for {url} timed out after {COMMAND_TIMEOUT}s") from None
    if proc.returncode != 0:
        raise Failure(f"{command[0]} for {url} failed with status {proc.returncode}")
    return proc.stdout


def fetch_feed(url):
    return run_command("GROK_BOT_RELEASE_FETCH", DEFAULT_FETCH, url)


def parse_feed_response(content, url):
    """Parse JSON feed response and validate version and debUrl."""
    try:
        data = json.loads(content)
    except ValueError as exc:
        raise Failure(f"feed for {url} returned invalid JSON: {exc}")
    if not isinstance(data, dict):
        raise Failure(f"feed for {url} returned unexpected response shape: {content.strip()!r}")

    version = data.get("version")
    deb_url = data.get("debUrl")
    if not isinstance(version, str) or not isinstance(deb_url, str):
        error_msg = data.get("error") or data.get("message")
        if error_msg:
            raise Failure(f"feed for {url} returned error: {error_msg}")
        raise Failure(f"feed for {url} returned no version or debUrl: {content.strip()!r}")

    if not VERSION_PATTERN.match(version):
        raise Failure(f"feed for {url} returned invalid version: {version!r}")
    if not deb_url.startswith(ALLOWED_DEB_PREFIX):
        raise Failure(
            f"debUrl for {url} is not under {ALLOWED_DEB_PREFIX}: {deb_url!r}"
        )
    return version, deb_url


def parse_hash(output, url):
    """Return the SRI hash from nix store prefetch-file --json output."""
    try:
        sri = json.loads(output).get("hash")
    except (ValueError, AttributeError):
        sri = None
    if not isinstance(sri, str) or not SRI_PATTERN.match(sri):
        raise Failure(f"prefetch output for {url} carries no sha256 SRI hash: {output.strip()!r}")
    return sri


def prefetch_deb(url):
    output = run_command("GROK_BOT_RELEASE_PREFETCH", DEFAULT_PREFETCH, url)
    return parse_hash(output, url)


def version_tuple(version):
    if not isinstance(version, str) or not VERSION_PATTERN.match(version):
        raise ValueError(f"not a version string: {version!r}")
    return tuple(int(part) for part in version.split("."))


def pinned_version(path):
    """Read the pinned version, treating a missing or malformed pin as absent."""
    if not path:
        return None
    try:
        with open(path, "r", encoding="utf-8") as f:
            data = json.load(f)
        if isinstance(data, dict):
            return data.get("version")
        return None
    except Exception:
        return None


def write_atomically(path, text):
    directory = os.path.dirname(os.path.abspath(path))
    fd, tmp = tempfile.mkstemp(dir=directory, prefix=".grok-bot-release.")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
        os.chmod(tmp, 0o644)
        os.replace(tmp, path)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--output",
        "-o",
        help="Path to grok-bot-release.json to write or update",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Print resolved JSON to stdout without modifying files",
    )
    args = parser.parse_args(argv)

    try:
        feed_results = {}
        for platform, url in PLATFORMS.items():
            feed_results[platform] = parse_feed_response(fetch_feed(url), url)

        versions = {platform: res[0] for platform, res in feed_results.items()}
        deb_urls = {platform: res[1] for platform, res in feed_results.items()}

        x64_ver = versions["x86_64-linux"]
        arm64_ver = versions["aarch64-linux"]
        if x64_ver != arm64_ver:
            raise Failure(
                f"architectures disagree on version: x86_64-linux has {x64_ver}, aarch64-linux has {arm64_ver}"
            )
        version = x64_ver

        write = not args.dry_run and bool(args.output)
        if write:
            current_version = pinned_version(args.output)
            if current_version is not None:
                try:
                    is_newer = version_tuple(version) > version_tuple(current_version)
                except ValueError:
                    is_newer = True
                if not is_newer:
                    if version == current_version:
                        print(f"{args.output} is already up to date at version {current_version}")
                    else:
                        print(
                            f"{args.output} is already up to date at version {current_version} "
                            f"(feed {version} is older)"
                        )
                    return 0

        platforms = {}
        for platform in ("x86_64-linux", "aarch64-linux"):
            deb_url = deb_urls[platform]
            sri = prefetch_deb(deb_url)
            platforms[platform] = {
                "url": deb_url,
                "hash": sri,
            }

        pin_data = {
            "version": version,
            "platforms": platforms,
        }
        out_json = json.dumps(pin_data, indent=2) + "\n"

        if not write:
            sys.stdout.write(out_json)
            return 0

        write_atomically(args.output, out_json)
        print(f"updated {args.output} to version {version}")
        return 0

    except (Failure, OSError) as exc:
        print(f"grok-bot-release: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
