#!/usr/bin/env bash
# Prints Pi's Synthetic API key on stdout. Pi runs this as the provider's
# `!` apiKey command for every request, so the key never sits in Pi's
# environment, where every command a tool runs would inherit it. The Nix
# package replaces the @...@ constant. Builtins only, so the helper needs
# nothing on PATH.
set -euo pipefail

KEY_FILE='@SYNTHETIC_KEY_FILE@'

# A key the caller already exported wins, so another account can be tested
# without touching secrets.
if [[ -n ${SYNTHETIC_API_KEY:-} ]]; then
  printf '%s' "$SYNTHETIC_API_KEY"
  exit 0
fi

# Anything wrong with the file means no key, and Synthetic then refuses every
# request: the file is absent on bootstrap generations, and saying nothing
# about it keeps every run quiet. A missing, unreadable, or directory path
# fails the read, which leaves key empty.
key=
{ IFS= read -r -d '' -N 16384 key <"$KEY_FILE"; } 2>/dev/null || true
key=${key%"${key##*[![:space:]]}"}
if [[ -n $key && ${#key} -le 8192 && $key != *[[:space:][:cntrl:]]* ]]; then
  printf '%s' "$key"
fi
