#!/usr/bin/env python3
"""Rewrite the committed OpenRouter catalog snapshot from OpenRouter's API.

Fetches https://openrouter.ai/api/v1/models/user, or reads a catalog file
given with --catalog, and writes `--snapshot FILE`: every row whose output
modalities include `text`, sorted by `id` and trimmed to the fields OMP's
model config renders, in the catalog's own shape:

- `id`, `name`, `context_length`
- `architecture.input_modalities` and `architecture.output_modalities`
- `top_provider.context_length` and `top_provider.max_completion_tokens`,
  each kept as null when the catalog gives null
- `pricing.prompt`, `pricing.completion`, and `pricing.input_cache_read` and
  `pricing.input_cache_write` when present, each a numeric string
- `reasoning` as given, when present

A row whose output lacks `text` is skipped, because OMP cannot serve it as a
chat model. A malformed row is skipped with a warning naming it on stderr,
keeping its previous entry from FILE when one exists. The run exits non-zero,
leaving FILE as it is, when no row is left or when the valid rows shrink
below the retention floor of FILE, and FILE is untouched unless the content
changes.

OPENROUTER_API_KEY must be set and non-empty to fetch. It is sent as a bearer
header on the fetch command's stdin, never in its argv, and never printed.
"""

import argparse
import json
import os
import re
import sys

# The shared module sits beside this script, also when a test loads it by
# path or Python runs it isolated.
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from catalog_snapshot import (  # noqa: E402
    Failure,
    check_shrink_floor,
    existing_rows,
    is_int,
    is_strings,
    read_json,
    run_fetch,
    write_if_changed,
)

DEFAULT_URL = "https://openrouter.ai/api/v1/models/user"
KEY_VARIABLE = "OPENROUTER_API_KEY"
NAME = "openrouter-catalog-snapshot"

PRICE_FIELDS = ("prompt", "completion", "input_cache_read", "input_cache_write")
REQUIRED_PRICES = ("prompt", "completion")
PRICE_PATTERN = re.compile(r"-?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?")


def fetch(url):
    """Return the catalog body; the key travels only on the command's stdin."""
    key = os.environ.get(KEY_VARIABLE, "")
    if not key:
        raise Failure(f"{KEY_VARIABLE} is not set")
    proc = run_fetch(url, key, KEY_VARIABLE)
    if proc.returncode != 0:
        raise Failure(f"fetching {url} failed with status {proc.returncode}")
    try:
        return json.loads(proc.stdout)
    except json.JSONDecodeError:
        raise Failure(f"fetching {url} returned a body that is not JSON") from None


def snapshot_row(row):
    """The trimmed row, None for a non-text model, or a Failure naming the bad field."""
    model_id = row.get("id") if isinstance(row, dict) else None
    if not isinstance(model_id, str) or model_id == "":
        raise Failure(f"catalog entry {json.dumps(row)[:120]} has no valid id")

    def bad(field):
        return Failure(f"catalog entry {model_id} has no valid {field}")

    architecture = row.get("architecture")
    if not isinstance(architecture, dict):
        raise bad("architecture")
    for field in ("input_modalities", "output_modalities"):
        if not is_strings(architecture.get(field)):
            raise bad(f"architecture.{field}")
    if "text" not in architecture["output_modalities"]:
        return None
    if not isinstance(row.get("name"), str) or row["name"] == "":
        raise bad("name")
    if not is_int(row.get("context_length")):
        raise bad("context_length")
    top = row.get("top_provider")
    if not isinstance(top, dict):
        raise bad("top_provider")
    for field in ("context_length", "max_completion_tokens"):
        if top.get(field) is not None and not is_int(top[field]):
            raise bad(f"top_provider.{field}")
    pricing = row.get("pricing")
    if not isinstance(pricing, dict):
        raise bad("pricing")
    for field in PRICE_FIELDS:
        present = field in pricing
        if (field in REQUIRED_PRICES and not present) or (
            present and not (isinstance(pricing[field], str) and PRICE_PATTERN.fullmatch(pricing[field]))
        ):
            raise bad(f"pricing.{field}")
    kept = {
        "id": model_id,
        "name": row["name"],
        "architecture": {field: architecture[field] for field in ("input_modalities", "output_modalities")},
        "context_length": row["context_length"],
        "top_provider": {field: top.get(field) for field in ("context_length", "max_completion_tokens")},
        "pricing": {field: pricing[field] for field in PRICE_FIELDS if field in pricing},
    }
    if "reasoning" in row:
        reasoning = row["reasoning"]
        if reasoning is not None and not (
            isinstance(reasoning, dict)
            and ("supported_efforts" not in reasoning or is_strings(reasoning["supported_efforts"]))
        ):
            raise bad("reasoning")
        kept["reasoning"] = reasoning
    return kept


def catalog_snapshot(catalog, previous=None):
    data = catalog.get("data") if isinstance(catalog, dict) else None
    if not isinstance(data, list):
        raise Failure("the catalog has no data list")
    previous = previous or {}
    kept, fresh = {}, set()
    for row in data:
        try:
            entry = snapshot_row(row)
        except Failure as exc:
            print(f"{NAME}: skipping {exc}", file=sys.stderr)
            model_id = row.get("id") if isinstance(row, dict) else None
            if isinstance(model_id, str) and model_id in previous:
                kept.setdefault(model_id, previous[model_id])
            continue
        if entry is not None:
            kept[entry["id"]] = entry
            fresh.add(entry["id"])
    if not fresh:
        raise Failure("the catalog lists no text models")
    check_shrink_floor(len(fresh), len(previous))
    return json.dumps({"data": [kept[i] for i in sorted(kept)]}, indent=2) + "\n"


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--catalog", help="Read the catalog from this JSON file instead of fetching it")
    parser.add_argument("--url", default=DEFAULT_URL, help="Catalog URL (default: %(default)s)")
    parser.add_argument("--snapshot", metavar="FILE", required=True, help="Rewrite this catalog snapshot")
    args = parser.parse_args(argv)
    try:
        catalog = read_json(args.catalog) if args.catalog else fetch(args.url)
        previous = existing_rows(args.snapshot, snapshot_row)
        write_if_changed(args.snapshot, catalog_snapshot(catalog, previous))
        return 0
    except (Failure, OSError) as exc:
        print(f"{NAME}: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
