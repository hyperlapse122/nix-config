#!/usr/bin/env python3
"""Resolve the newest upstream release of WiFiman Desktop for Linux.

Queries Ubiquiti's community GraphQL API for the WiFiman releases, keeps the
Desktop ones, and picks the numerically highest version. Upstream publishes no
checksum, so the helper downloads the amd64 .deb through a prefetch command and
writes or checks the version pin file with its sha256 and SRI hash. Refuses to
write a version that is not strictly newer than the one already pinned, and
downloads nothing when the pin is already current.
"""

import argparse
import base64
import json
import os
import re
import shlex
import subprocess
import sys

DEFAULT_SOURCE_URL = "https://community.svc.ui.com/"
DEFAULT_FETCH = "curl -s -X POST -H 'content-type: application/json' --data-binary @-"
DEFAULT_PREFETCH = "nix-prefetch-url --type sha256"
QUERY = 'query { releases(tags: ["wifiman"]) { items { title version } } }'
DEB_URL = "https://desktop.wifiman.com/wifiman-desktop-{version}-amd64.deb"

VERSION_PATTERN = re.compile(r"^\d+(?:\.\d+)*$")
SHA256_HEX_PATTERN = re.compile(r"^[0-9a-fA-F]{64}$")
NIX32_PATTERN = re.compile(r"^[0-9a-df-np-sv-z]{52}$")
NIX32_ALPHABET = "0123456789abcdfghijklmnpqrsvwxyz"


class Failure(Exception):
    """A refusal that should stop the caller with a readable message."""


def run_command(env_name, default, url, stdin_text=None):
    """Run an overridable command with the URL appended and return its stdout.

    The commands are overridable so offline tests and sandboxed Nix checks can
    provide fixtures instead of network calls.
    """
    command = shlex.split(os.environ.get(env_name, default))
    if not command:
        raise Failure(f"{env_name} is empty")
    proc = subprocess.run(
        command + [url],
        input=stdin_text,
        stdin=None if stdin_text is not None else subprocess.DEVNULL,
        capture_output=True,
        text=True,
    )
    if proc.returncode != 0:
        raise Failure(f"{command[0]} for {url} failed with status {proc.returncode}")
    return proc.stdout


def fetch(source_url):
    body = json.dumps({"query": QUERY})
    return run_command("WIFIMAN_DESKTOP_RELEASE_FETCH", DEFAULT_FETCH, source_url, body)


def version_tuple(version):
    if not isinstance(version, str) or not VERSION_PATTERN.match(version):
        raise ValueError(f"not a version string: {version!r}")
    return tuple(int(part) for part in version.split("."))


def parse_releases(content):
    """Return (version tuple, version) pairs for the Desktop releases."""
    try:
        data = json.loads(content)
    except ValueError as exc:
        raise Failure(f"response is not valid JSON: {exc}")
    try:
        items = data["data"]["releases"]["items"]
        titles = [(item["title"], item["version"]) for item in items]
    except (KeyError, TypeError):
        raise Failure("unexpected response shape: missing data.releases.items")

    candidates = []
    for title, version in titles:
        if not isinstance(title, str) or "Desktop" not in title:
            continue
        try:
            candidates.append((version_tuple(version), version))
        except ValueError:
            continue
    return candidates


def resolve_latest(candidates):
    """Return the numerically highest version."""
    if not candidates:
        raise Failure("no Desktop release found in response")
    return max(candidates, key=lambda c: c[0])[1]


def nix32_to_bytes(text):
    """Decode a Nix base32 sha256, whose digits run from the least significant end."""
    value = 0
    for n, char in enumerate(reversed(text)):
        value |= NIX32_ALPHABET.index(char) << (5 * n)
    if value >> 256:
        raise Failure(f"not a sha256 hash: {text!r}")
    return value.to_bytes(32, "little")


def parse_hash(output):
    """Return the sha256 hex digest from a prefetch command's stdout."""
    text = output.strip()
    if SHA256_HEX_PATTERN.match(text):
        return text.lower()
    if NIX32_PATTERN.match(text):
        return nix32_to_bytes(text).hex()
    raise Failure(f"prefetch output is not a sha256 hash: {text!r}")


def hex_to_sri(sha256_hex):
    """Convert a 64-character hex sha256 string to Nix SRI format."""
    return "sha256-" + base64.b64encode(bytes.fromhex(sha256_hex)).decode("ascii")


def resolve_pin(version):
    """Download the .deb for a version through the prefetch command and pin it."""
    url = DEB_URL.format(version=version)
    sha256_hex = parse_hash(run_command("WIFIMAN_DESKTOP_RELEASE_PREFETCH", DEFAULT_PREFETCH, url))
    return {"version": version, "sha256": sha256_hex, "hash": hex_to_sri(sha256_hex)}


def pinned_version(path):
    """Read the pinned version, treating a missing or malformed pin as absent."""
    try:
        with open(path, "r", encoding="utf-8") as f:
            current = json.load(f)
        return current.get("version")
    except Exception:
        return None


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--source-url",
        default=DEFAULT_SOURCE_URL,
        help="Ubiquiti community GraphQL endpoint",
    )
    parser.add_argument(
        "--output",
        "-o",
        help="Path to wifiman-desktop-version.json to write or update",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Print resolved JSON to stdout without modifying files",
    )
    args = parser.parse_args(argv)

    try:
        version = resolve_latest(parse_releases(fetch(args.source_url)))

        if args.dry_run or not args.output:
            sys.stdout.write(json.dumps(resolve_pin(version), indent=2) + "\n")
            return 0

        current_version = pinned_version(args.output)
        if current_version is not None:
            try:
                is_newer = version_tuple(version) > version_tuple(current_version)
            except ValueError:
                is_newer = True
            if not is_newer:
                print(
                    f"{args.output} is already up to date at version {current_version} "
                    f"(resolved {version} is not newer)"
                )
                return 0

        out_json = json.dumps(resolve_pin(version), indent=2) + "\n"
        with open(args.output, "w", encoding="utf-8") as f:
            f.write(out_json)
        print(f"updated {args.output} to version {version}")
        return 0

    except (Failure, OSError) as exc:
        print(f"wifiman-desktop-release: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
