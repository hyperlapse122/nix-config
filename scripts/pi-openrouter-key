#!/usr/bin/env bash
# Prints Pi's OpenRouter API key on stdout. Pi runs this as the provider's
# `!` apiKey command for every request, so the key never sits in Pi's
# environment, where every command a tool runs would inherit it. The Nix
# package replaces the @...@ constant. Builtins only, so the helper needs
# nothing on PATH.
set -euo pipefail

KEY_FILE='@OPENROUTER_KEY_FILE@'

# A key the caller already exported wins, so another account can be tested
# without touching secrets.
if [[ -n ${OPENROUTER_API_KEY:-} ]]; then
  printf '%s' "$OPENROUTER_API_KEY"
  exit 0
fi

# A key is 1-8192 printable ASCII characters after trailing ASCII blanks are
# cut. The C locale makes the classes ASCII-only, so the rule matches the Pi
# extension's readKey whatever locale the caller set.
LC_ALL=C
key=
{ IFS= read -r -d '' -N 16384 key <"$KEY_FILE"; } 2>/dev/null || true
key=${key%"${key##*[![:space:]]}"}
if [[ -n $key && ${#key} -le 8192 && $key != *[![:graph:]]* ]]; then
  printf '%s' "$key"
fi
