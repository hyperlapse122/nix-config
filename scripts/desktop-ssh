#!/usr/bin/env python3
"""Provision the desktop's protected host SSH key through KWallet."""

import argparse
import base64
import ctypes
import fcntl
import hashlib
import os
from pathlib import Path
import resource
import secrets
import stat
import sys

from cryptography.hazmat.primitives import serialization
from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey, Ed25519PublicKey
from cryptography.exceptions import UnsupportedAlgorithm


class DesktopSSHError(RuntimeError):
    """An error safe to present without credential contents."""


def disable_core_dumps():
    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
    # PR_SET_DUMPABLE also prevents same-UID ptrace of the credential process.
    if ctypes.CDLL(None, use_errno=True).prctl(4, 0, 0, 0, 0) != 0:
        raise DesktopSSHError("cannot disable credential process dumps")


def public_bytes(key):
    return key.public_bytes(serialization.Encoding.OpenSSH,
                            serialization.PublicFormat.OpenSSH)


def fingerprint(key):
    blob = base64.b64decode(public_bytes(key).split()[1], validate=True)
    return "SHA256:" + base64.b64encode(hashlib.sha256(blob).digest()).decode().rstrip("=")


def read_public_key(path):
    try:
        data = Path(path).read_bytes()
        if len(data) > 16384:
            raise ValueError()
        key = serialization.load_ssh_public_key(data)
        if not isinstance(key, Ed25519PublicKey):
            raise ValueError()
        return key
    except (ValueError, TypeError, OSError):
        raise DesktopSSHError("declared SSH public key must be a valid Ed25519 key") from None


def _check_private_file(info, owner=None):
    owner = os.getuid() if owner is None else owner
    if (not stat.S_ISREG(info.st_mode) or info.st_uid != owner
            or stat.S_IMODE(info.st_mode) not in (0o400, 0o600)
            or info.st_nlink != 1):
        raise DesktopSSHError("SSH state must be an owned private regular file (mode 0600 or 0400)")


def read_private_file(path, source=False):
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
        with os.fdopen(fd, "rb") as stream:
            info = os.fstat(stream.fileno())
            _check_private_file(info, info.st_uid if source and info.st_uid == 0 else None)
            data = stream.read(65537)
            if len(data) > 65536:
                raise DesktopSSHError("SSH key exceeds the supported size")
            return data
    except OSError:
        raise DesktopSSHError("cannot read private SSH state; check ownership, mode and symlinks") from None


class KWallet:
    APP = "nix-config-desktop-ssh"
    FOLDER = "nix-config SSH"

    def __init__(self):
        import dbus

        self.dbus = dbus
        self.handle = None
        try:
            # System services must not inherit an arbitrary caller's bus address.
            bus = dbus.bus.BusConnection(f"unix:path=/run/user/{os.getuid()}/bus")
            self.interface = dbus.Interface(
                bus.get_object("org.kde.kwalletd6", "/modules/kwalletd6"),
                "org.kde.KWallet")
            self.handle = int(self.interface.open("kdewallet", dbus.Int64(0), self.APP,
                                                  timeout=90))
            if self.handle < 0:
                raise DesktopSSHError("unlock kdewallet in KWallet Manager, then retry SSH")
            if not self.interface.hasFolder(self.handle, self.FOLDER, self.APP):
                if not self.interface.createFolder(self.handle, self.FOLDER, self.APP):
                    raise DesktopSSHError("cannot create SSH password folder in kdewallet")
        except dbus.DBusException:
            self.close()
            raise DesktopSSHError("KWallet unavailable; unlock kdewallet in the desktop session and retry SSH") from None
        except DesktopSSHError:
            self.close()
            raise

    def read(self, name):
        try:
            if not self.interface.hasEntry(self.handle, self.FOLDER, name, self.APP):
                return None
            value = str(self.interface.readPassword(self.handle, self.FOLDER, name, self.APP))
            if not value:
                raise DesktopSSHError("SSH password entry in KWallet is empty; restore the wallet entry")
            return value
        except self.dbus.DBusException:
            raise DesktopSSHError("cannot read SSH password; unlock kdewallet and retry SSH") from None

    def write(self, name, value):
        try:
            if self.interface.writePassword(self.handle, self.FOLDER, name, value, self.APP) != 0:
                raise DesktopSSHError("cannot store SSH password in kdewallet")
            self.interface.sync(self.handle, self.APP, ignore_reply=True)
        except self.dbus.DBusException:
            raise DesktopSSHError("cannot store SSH password in kdewallet") from None

    def close(self):
        if self.handle is not None:
            try:
                self.interface.close(self.handle, False, self.APP)
            except self.dbus.DBusException:
                pass
            self.handle = None


def _open_key_directory(path):
    path = Path(path).absolute()
    # Refuse redirectable ancestors before creating the dedicated SSH directory.
    for parent in reversed(path.parents):
        info = parent.lstat()
        if (not stat.S_ISDIR(info.st_mode)
                or (info.st_mode & 0o022 and not info.st_mode & stat.S_ISVTX)):
            raise DesktopSSHError("SSH directory has a writable ancestor or symlink")
    try:
        path.mkdir(mode=0o700)
    except FileExistsError:
        pass
    try:
        fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except OSError:
        raise DesktopSSHError("SSH directory is unsafe or inaccessible") from None
    info = os.fstat(fd)
    if info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) != 0o700:
        os.close(fd)
        raise DesktopSSHError("SSH directory must be owned by the user with mode 0700")
    return fd


def _read_working(directory, name):
    try:
        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC,
                     dir_fd=directory)
    except FileNotFoundError:
        return None
    except OSError:
        raise DesktopSSHError("working SSH key is unsafe or inaccessible") from None
    with os.fdopen(fd, "rb") as stream:
        _check_private_file(os.fstat(stream.fileno()))
        data = stream.read(65537)
        if len(data) > 65536:
            raise DesktopSSHError("working SSH key exceeds the supported size")
        return data


def load_working_key(key_file, declared_public, wallet):
    """Read and decrypt an existing working key; never publish or fall back here."""
    password = wallet.read(fingerprint(declared_public))
    if password is None:
        raise DesktopSSHError("SSH password missing from KWallet; retry provisioning")
    try:
        key = serialization.load_ssh_private_key(read_private_file(key_file), password.encode())
        if (not isinstance(key, Ed25519PrivateKey)
                or public_bytes(key.public_key()) != public_bytes(declared_public)):
            raise ValueError()
        return key
    except (ValueError, TypeError):
        raise DesktopSSHError("protected SSH key and wallet entry do not match; retry provisioning") from None


def provision(source, public_key, key_file, wallet):
    """Return whether publication changed; wallet may be a fake boundary in tests."""
    declared = read_public_key(public_key)
    try:
        source_key = serialization.load_ssh_private_key(read_private_file(source, source=True), None)
        if (not isinstance(source_key, Ed25519PrivateKey)
                or public_bytes(source_key.public_key()) != public_bytes(declared)):
            raise ValueError()
    except (ValueError, TypeError):
        raise DesktopSSHError("recovery SSH key does not match declared Ed25519 identity") from None
    key_file = Path(key_file)
    directory = _open_key_directory(key_file.parent)
    lock_fd = None
    staging_name = None
    try:
        try:
            lock_fd = os.open(".desktop-ssh.lock", os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW
                              | os.O_NONBLOCK | os.O_CLOEXEC, 0o600, dir_fd=directory)
        except OSError:
            raise DesktopSSHError("cannot open private SSH provisioning lock") from None
        _check_private_file(os.fstat(lock_fd))
        fcntl.flock(lock_fd, fcntl.LOCK_EX)
        existing = _read_working(directory, key_file.name)
        name = fingerprint(declared)
        password = wallet.read(name)
        if password is None:
            password = secrets.token_urlsafe(48)
            wallet.write(name, password)
        if not password or wallet.read(name) != password:
            raise DesktopSSHError("SSH wallet password readback failed; existing key was preserved")
        if existing is not None:
            try:
                key = serialization.load_ssh_private_key(existing, password.encode())
                if (isinstance(key, Ed25519PrivateKey)
                        and public_bytes(key.public_key()) == public_bytes(declared)):
                    return False
            except (ValueError, TypeError):
                pass
        protected = source_key.private_bytes(
            serialization.Encoding.PEM, serialization.PrivateFormat.OpenSSH,
            serialization.BestAvailableEncryption(password.encode()))
        validated = serialization.load_ssh_private_key(protected, password.encode())
        if public_bytes(validated.public_key()) != public_bytes(declared):
            raise DesktopSSHError("encrypted SSH key validation failed")
        staging_name = ".desktop-ssh-" + secrets.token_hex(16)
        fd = os.open(staging_name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW
                     | os.O_CLOEXEC, 0o600, dir_fd=directory)
        with os.fdopen(fd, "wb") as stream:
            stream.write(protected)
            stream.flush()
            os.fsync(stream.fileno())
        # Recheck a destination an operator may have changed while KWallet opened.
        _read_working(directory, key_file.name)
        os.replace(staging_name, key_file.name, src_dir_fd=directory, dst_dir_fd=directory)
        staging_name = None
        os.fsync(directory)
        return True
    finally:
        if staging_name is not None:
            os.unlink(staging_name, dir_fd=directory)
        if lock_fd is not None:
            os.close(lock_fd)
        os.close(directory)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    setup = commands.add_parser("provision")
    setup.add_argument("--source", required=True)
    setup.add_argument("--public-key", required=True)
    setup.add_argument("--key-file", required=True)
    args = parser.parse_args()
    wallet = None
    try:
        disable_core_dumps()
        os.umask(0o077)
        wallet = KWallet()
        provision(args.source, args.public_key, args.key_file, wallet)
        return 0
    except (DesktopSSHError, OSError, ValueError, TypeError, UnsupportedAlgorithm):
        # OSError may carry secret-derived data from third-party code; never print it.
        message = "local SSH provisioning failed; check private file permissions and unlock kdewallet"
        error = sys.exc_info()[1]
        if isinstance(error, DesktopSSHError):
            message = str(error)
        print(f"desktop-ssh: {message}", file=sys.stderr)
        return 1
    finally:
        if wallet is not None:
            wallet.close()


if __name__ == "__main__":
    sys.exit(main())
