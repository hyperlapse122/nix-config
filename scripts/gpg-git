#!/usr/bin/env python3
"""Refresh macOS card discovery before Git selects its signing key."""

import os
import subprocess
import sys


def main():
    args = sys.argv[1:]
    # Git's OpenPGP signing invocation. Verification and arbitrary GPG calls
    # pass through without touching the card or consuming their input.
    if len(args) == 3 and args[:2] == ["--status-fd=2", "-bsau"]:
        try:
            subprocess.run(
                ["gpg", "--batch", "--card-status"],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=10,
            )
        except (OSError, subprocess.TimeoutExpired):
            pass
    # Preserve GPG's streams, signal handling and status. In particular, never
    # retry a signing operation that might already have submitted a bad PIN.
    os.execvp("gpg", ["gpg", *args])


if __name__ == "__main__":
    main()
