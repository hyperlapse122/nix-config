#!/usr/bin/env python3
"""Resolve the newest upstream OpenCode release from the npm registry.

OpenCode v2 is published as @opencode/cli, with one @opencode/cli-<platform>
package per supported system. Reads the registry's latest manifest for the
version, requires each pinned platform package in its optionalDependencies at
exactly that version, reads each platform manifest for its tarball URL and
sha512 integrity, and writes or checks the pin file packages/opencode.nix
consumes. Refuses a version that is not plain dotted numbers (the dev and beta
builds), a deprecated package, a manifest whose name or version differs from
the request, an integrity that is not one sha512 digest, and a tarball outside
registry.npmjs.org. Leaves the pin alone when the resolved version is not
strictly newer than the one already pinned, so neither an incomplete release
nor a downgrade ever reaches the pin file.
"""

import argparse
import concurrent.futures
import json
import os
import re
import shlex
import subprocess
import sys

DEFAULT_SOURCE_URL = "https://registry.npmjs.org"
DEFAULT_FETCH = "curl -sfL --max-time 60"
CLI_PACKAGE = "@opencode/cli"
TARBALL_PREFIX = DEFAULT_SOURCE_URL + "/"

# Every system a host in this flake can be, and the platform package installed
# on it.
TARGET_PACKAGES = {
    "x86_64-linux": "@opencode/cli-linux-x64",
    "aarch64-linux": "@opencode/cli-linux-arm64",
    "aarch64-darwin": "@opencode/cli-darwin-arm64",
}

VERSION_PATTERN = re.compile(r"^\d+(?:\.\d+)*$")
# One sha512 SRI: a 64-byte digest is always 86 base64 characters plus "==".
INTEGRITY_PATTERN = re.compile(r"sha512-[A-Za-z0-9+/]{86}==")


class Failure(Exception):
    """A refusal that should stop the caller with a readable message."""


def fetch(url):
    """Run the overridable fetch command against one URL and return the raw body.

    The command is overridable so offline tests and sandboxed Nix checks can
    provide fixtures instead of network calls.
    """
    command = shlex.split(os.environ.get("OPENCODE_RELEASE_FETCH", DEFAULT_FETCH))
    if not command:
        raise Failure("OPENCODE_RELEASE_FETCH is empty")
    proc = subprocess.run(
        command + [url],
        stdin=subprocess.DEVNULL,
        capture_output=True,
        text=True,
    )
    if proc.returncode != 0:
        raise Failure(f"fetching {url} failed with status {proc.returncode}")
    return proc.stdout


def fetch_manifest(url):
    """Fetch one registry manifest and return it as a JSON object."""
    try:
        data = json.loads(fetch(url))
    except json.JSONDecodeError as exc:
        raise Failure(f"response from {url} is not JSON: {exc}") from None
    if not isinstance(data, dict):
        raise Failure(f"response from {url} is not a JSON object")
    if "deprecated" in data:
        raise Failure(f"{url} is deprecated: {data['deprecated']!r}; refusing to pin it")
    return data


def check_integrity(package, integrity):
    """Require one sha512 SRI whose digest is 64 bytes, and return it unchanged."""
    if not isinstance(integrity, str) or not INTEGRITY_PATTERN.fullmatch(integrity):
        raise Failure(f"invalid sha512 integrity for {package}: {integrity!r}")
    return integrity


def resolve(base):
    """Return the pin for the registry's latest @opencode/cli release."""
    base = base.rstrip("/")
    latest = fetch_manifest(f"{base}/{CLI_PACKAGE}/latest")
    version = latest.get("version")
    if not isinstance(version, str) or not VERSION_PATTERN.match(version):
        raise Failure(f"release version is not a plain version string: {version!r}")

    optional = latest.get("optionalDependencies")
    optional = optional if isinstance(optional, dict) else {}
    platforms = {}
    # The platform manifests are fetched together and read in the fixed order
    # below, so a refusal names the same package a serial fetch would.
    with concurrent.futures.ThreadPoolExecutor() as pool:
        manifests = {
            package: pool.submit(fetch_manifest, f"{base}/{package}/{version}")
            for package in TARGET_PACKAGES.values()
        }
        for system, package in TARGET_PACKAGES.items():
            if optional.get(package) != version:
                raise Failure(
                    f"{CLI_PACKAGE} {version} does not list {package} at {version} "
                    f"(found {optional.get(package)!r}); refusing to write an incomplete pin"
                )
            manifest = manifests[package].result()
            if manifest.get("name") != package or manifest.get("version") != version:
                raise Failure(
                    f"manifest for {package} {version} names "
                    f"{manifest.get('name')!r} {manifest.get('version')!r}"
                )
            dist = manifest.get("dist")
            dist = dist if isinstance(dist, dict) else {}
            url = dist.get("tarball")
            if not isinstance(url, str) or not url.startswith(TARBALL_PREFIX):
                raise Failure(
                    f"tarball for {package} {version} is not under {TARBALL_PREFIX}: {url!r}"
                )
            platforms[system] = {
                "url": url,
                "hash": check_integrity(package, dist.get("integrity")),
            }
    return {"version": version, "platforms": platforms}


def version_tuple(version):
    if not isinstance(version, str):
        raise ValueError(f"not a version string: {version!r}")
    return tuple(int(part) for part in version.split("."))


def pinned_version(path):
    """Return the version already pinned at path, or None when unreadable."""
    try:
        with open(path, "r", encoding="utf-8") as f:
            current = json.load(f)
        return current.get("version")
    except Exception:
        return None


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--source-url",
        default=DEFAULT_SOURCE_URL,
        help="Base URL of the npm registry to read",
    )
    parser.add_argument(
        "--output",
        "-o",
        help="Path to the opencode-release.json pin file to write or update",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Print the resolved pin JSON to stdout without modifying files",
    )
    args = parser.parse_args(argv)

    try:
        resolved = resolve(args.source_url)
        out_json = json.dumps(resolved, indent=2) + "\n"

        if args.dry_run or not args.output:
            sys.stdout.write(out_json)
            return 0

        current_version = pinned_version(args.output)
        if current_version is not None:
            try:
                is_newer = version_tuple(resolved["version"]) > version_tuple(current_version)
            except ValueError:
                is_newer = True
            if not is_newer:
                print(
                    f"{args.output} is already up to date at version {current_version} "
                    f"(resolved {resolved['version']} is not newer)"
                )
                return 0

        with open(args.output, "w", encoding="utf-8") as f:
            f.write(out_json)
        print(f"updated {args.output} to version {resolved['version']}")
        return 0

    except (Failure, OSError) as exc:
        print(f"opencode-release: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
