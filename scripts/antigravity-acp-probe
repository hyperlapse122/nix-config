#!/usr/bin/env python3
"""Report what a T3 Code Antigravity instance loads under a chosen ACP runtime version.

T3 Code starts agy_acp_server.par with GEMINI_HOME set to an instance home under
~/.t3/userdata/providers/antigravity, and t3code-antigravity-link links the
plugin skills into it. The repository no longer writes the CLI's global rules,
so the instructions verdict needs a config/AGENTS.md placed in the home by
hand. The repository's checks prove the links exist, not that the runtime
reads them, and the agy CLI ignores
GEMINI_HOME, so it cannot answer the question either. This probe starts the
runtime itself, the way T3 Code does, against that home, asks the session what
it holds, and reports five verdicts: plugin skills, global instructions,
auto-memories, and two rule paths the runtime may read, <workspace>/.agents/rules
and <GEMINI_HOME>/config/rules.

The runtime is the one T3 Code installed when its version matches; otherwise
the probe downloads the archive from Google into ~/.cache/antigravity-acp-probe
and prints its sha256. The version packages/t3code-release.json pins must match
its pinned digest. Any other version is trusted on its HTTPS origin alone,
because no trusted digest exists for it; its extracted files are hashed once
and rechecked on every reuse.

The session runs with every built-in tool disabled and no MCP server, in a
temporary workspace whose AGENTS.md and .agents/rules file carry random markers,
so the model can answer only from its context. The probe also plants a marker file
in the instance home's config/rules for the run and removes it afterwards. Each verdict reads only the answer's section
under its own heading. Every verdict is undetermined when the turn did not end
normally, a heading is missing, or the session reported a tool call. The skills
verdict is loaded only when every skill is listed and the control skill's
description comes back quoted, which proves the session answered from its
context. The instructions verdict is loaded only when the answer returns the
GPG fingerprint the global rules name; it is not loaded only when the answer
writes NONE for it and the control description came back; otherwise it is
undetermined. Each rule verdict is loaded only when the answer returns that
path's marker, and is not loaded and undetermined on the same terms.

The probe needs the instance home signed in through T3 Code's settings, which
no check or CI runner has, so it is a manual utility: run it from a checkout in
a desktop session. It is not installed on hosts and no check runs it, though
tests/test_antigravity_acp_probe.py covers its verdicts and cleanup. Its
conversations stay in the instance home.
"""

import argparse
import hashlib
import json
import os
import platform
import queue
import re
import secrets
import shutil
import signal
import subprocess
import sys
import tempfile
import threading
import time
import urllib.error
import urllib.request
import zipfile
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path
from typing import NamedTuple

PROG = "antigravity-acp-probe"
RELEASE_FILE = Path(__file__).resolve().parent.parent / "packages" / "t3code-release.json"
AUTH_PREFIX = "Open the following link to authenticate the ACP server: "
EXECUTABLE = "agy_acp_server.par"
HARNESS = "localharness_external"
RUNTIME_FILES = (EXECUTABLE, HARNESS)
BLOCK = 1 << 20
# The JSON-RPC error code the runtime answers with when the home needs a sign-in.
ACP_AUTH_REQUIRED = -32000
# T3 Code's removedEnvironmentKeys: credentials and the variables it sets itself.
REMOVED_ENVIRONMENT_KEYS = {
    "GEMINI_API_KEY",
    "GOOGLE_API_KEY",
    "GOOGLE_APPLICATION_CREDENTIALS",
    "GOOGLE_CLOUD_PROJECT",
    "GOOGLE_CLOUD_LOCATION",
    "GOOGLE_CLOUD_QUOTA_PROJECT",
    "GOOGLE_GENAI_USE_VERTEXAI",
    "GCLOUD_PROJECT",
    "CLOUDSDK_CORE_PROJECT",
    "AGY_ACP_CCPA_PROJECT",
    "AGY_ACP_ENABLE_OAUTH",
    "GEMINI_HOME",
    "AGY_ACP_FORCE_FILE_STORAGE",
    "ANTIGRAVITY_HARNESS_PATH",
    "BROWSER",
    "PYTHONUNBUFFERED",
    "ELECTRON_RUN_AS_NODE",
}
CA_BUNDLES = ("/etc/ssl/certs/ca-certificates.crt", "/etc/ssl/cert.pem")
MEMORY_STORES = ("implicit", "knowledge")
SHARED_RUN_WORDS = 6
HEADINGS = ("SKILLS", "CONTROL", "FINGERPRINT", "MARKER", "WORKSPACE_RULE", "GLOBAL_RULE", "MEMORIES")
# Release versions as Google names them; anything else could escape the cache directory.
VERSION_PATTERN = re.compile(r"\d+(\.\d+)+")
TERMINATING_SIGNALS = (signal.SIGTERM, signal.SIGHUP, signal.SIGQUIT)


class ProbeError(Exception):
    pass


class NotSignedIn(ProbeError):
    def __init__(self, reason):
        super().__init__(f"the instance home is not signed in ({reason}); sign in to Antigravity in T3 Code's settings")


def fail(message):
    print(f"{PROG}: {message}", file=sys.stderr)


class RuleProbe(NamedTuple):
    subject: str  # the verdict's name
    heading: str  # the answer heading the marker should come back under
    marker: str
    path: Path  # relative to the workspace, or absolute in the instance home


# Names the probe gives its global rule files and the marker each one holds,
# so a later run can find a file a killed run left behind.
GLOBAL_RULE_GLOB = f"{PROG}-*.md"
GLOBAL_RULE_MARKER = "PROBE-GLOBAL-RULE-"


def remove_stale_global_rules(rules_dir):
    """Remove global rule files an earlier run left behind.

    A run killed with SIGKILL, or one whose cleanup failed, leaves its file in
    the instance home, and every later T3 Code session there would load it.
    Only a file with the probe's name that holds the probe's marker is removed.
    """
    removed = []
    for path in sorted(rules_dir.glob(GLOBAL_RULE_GLOB)) if rules_dir.is_dir() else []:
        try:
            if path.is_file() and not path.is_symlink() and GLOBAL_RULE_MARKER in path.read_text():
                path.unlink()
                removed.append(path)
        except OSError as error:
            fail(f"warning: could not remove the stale rule {path}: {error}")
    return removed


def plant_global_rule(rule, created):
    """Write the global rule file, adding each directory created for it to `created`, deepest first.

    `created` is the caller's list, so a failure part way still leaves it
    naming every directory made so far.
    """
    directory = rule.path.parent
    missing = []
    while not directory.exists():
        missing.append(directory)
        directory = directory.parent
    for directory in reversed(missing):
        directory.mkdir()
        created.insert(0, directory)
    rule.path.write_text(f"# Global rule\n\nThe rule marker for the instance home is {rule.marker}.\n")


def remove_global_rule(rule, created):
    """Undo plant_global_rule, reporting rather than raising, so an error the run hit stays the one shown."""
    try:
        rule.path.unlink(missing_ok=True)
    except OSError as error:
        fail(f"warning: could not remove {rule.path}; remove it, or every T3 Code session in this home loads it: {error}")
        return
    for directory in created:
        try:
            if directory.is_dir() and not any(directory.iterdir()):
                directory.rmdir()
        except OSError as error:
            fail(f"warning: could not remove the directory {directory} the probe created: {error}")


class Platform(NamedTuple):
    system: str  # the Nix system packages/t3code-release.json pins under
    t3: str  # T3 Code's directory under ~/.t3/tools/antigravity-acp
    release_dir: str  # Google's release directory
    suffix: str  # the archive name's platform suffix


def current_platform():
    machine = platform.machine().lower()
    if sys.platform == "linux" and machine in ("x86_64", "amd64"):
        return Platform("x86_64-linux", "linux-x64", "linux", "linux-x86_64")
    if sys.platform == "linux" and machine in ("aarch64", "arm64"):
        return Platform("aarch64-linux", "linux-arm64", "linux", "linux-arm64")
    if sys.platform == "darwin" and machine == "arm64":
        return Platform("aarch64-darwin", "darwin-arm64", "macos", "darwin-arm64")
    raise ProbeError(f"no Antigravity runtime for {sys.platform} {machine}")


def sha256_file(path):
    # hashlib.file_digest needs Python 3.11; macOS ships 3.9 as /usr/bin/python3.
    digest = hashlib.sha256()
    with open(path, "rb") as stream:
        for block in iter(lambda: stream.read(BLOCK), b""):
            digest.update(block)
    return digest.hexdigest()


def redacted(text):
    """text with any URL removed, so a runtime error never prints a sign-in link."""
    return re.sub(r"https?://\S+", "<url>", str(text))


def copy_hashing(source, path):
    """Copy the source stream to path and return its sha256."""
    digest = hashlib.sha256()
    with open(path, "wb") as target:
        for block in iter(lambda: source.read(BLOCK), b""):
            digest.update(block)
            target.write(block)
    return digest.hexdigest()


def pinned_release(system):
    try:
        return json.loads(RELEASE_FILE.read_text())["antigravity"][system]
    except (OSError, ValueError, KeyError) as error:
        raise ProbeError(f"cannot read the pinned runtime from {RELEASE_FILE}: {error}") from error


def pinned_for(pin, version):
    """The repository's pin when it pins version, or None for an unpinned version."""
    return pin if pin["version"] == version else None


def check_pinned_sizes(directory, pinned):
    """Refuse runtime files whose sizes differ from the pin; the archive digest does not cover extracted files."""
    for member, key in ((EXECUTABLE, "executable"), (HARNESS, "harness")):
        size = (directory / member).stat().st_size
        if size != pinned[key]["bytes"]:
            raise ProbeError(f"{directory / member} has {size} bytes, not the pinned {pinned[key]['bytes']}; refusing to run it")


def managed_runtime(base_dir, t3_platform, version, pinned):
    """A T3 Code managed install of version whose runtime files are present, or None."""
    for marker in sorted((base_dir / "tools" / "antigravity-acp" / t3_platform / "versions").glob("*/.install-complete.json")):
        try:
            install = json.loads(marker.read_text())
        except (OSError, ValueError):
            continue
        if install.get("version") != version:
            continue
        # The files may be links into the Nix store that a garbage collection left dangling.
        if not all((marker.parent / member).is_file() for member in RUNTIME_FILES):
            continue
        if pinned:
            if install.get("releaseId") != pinned["sha256"]:
                raise ProbeError(f"{marker.parent} holds {version} with release {install.get('releaseId')}, not the pinned {pinned['sha256']}")
            check_pinned_sizes(marker.parent, pinned)
        return marker.parent, install.get("releaseId")
    return None


def extract(archive, destination):
    """Extract the runtime files into destination and return their sha256 by name."""
    files = {}
    with zipfile.ZipFile(archive) as bundle:
        for member in RUNTIME_FILES:
            info = next((entry for entry in bundle.infolist() if Path(entry.filename).name == member), None)
            if info is None:
                raise ProbeError(f"the archive has no {member}")
            with bundle.open(info) as source:
                files[member] = copy_hashing(source, destination / member)
            (destination / member).chmod(0o755)
    return files


def cached_runtime(cache_dir, release_dir, suffix, version, pinned):
    """The cached runtime for version, downloading it on first use. Return (directory, archive sha256)."""
    platform_dir = (cache_dir / suffix).absolute()
    entry_dir = platform_dir / version
    if not VERSION_PATTERN.fullmatch(version) or entry_dir.parent != platform_dir:
        raise ProbeError(f"{version!r} is not a release version such as 1.3.0")
    digest = pinned["sha256"] if pinned else None
    entry_file = entry_dir / "entry.json"
    try:
        entry = json.loads(entry_file.read_text())
    except FileNotFoundError:
        entry = None
    except ValueError as error:
        raise ProbeError(f"{entry_file}: {error}; remove {entry_dir} to fetch it again") from error
    if entry is not None:
        try:
            with ThreadPoolExecutor() as pool:
                found = dict(zip(RUNTIME_FILES, pool.map(sha256_file, (entry_dir / member for member in RUNTIME_FILES))))
            changed = [member for member in RUNTIME_FILES if found[member] != entry["files"][member]]
            archive_sha = entry["archive"]
        except (OSError, KeyError, TypeError) as error:
            raise ProbeError(f"{entry_dir} is incomplete ({error}); remove it to fetch it again") from error
        if changed:
            raise ProbeError(f"{entry_dir / changed[0]} changed since it was downloaded; remove {entry_dir} to fetch it again")
        if digest and archive_sha != digest:
            raise ProbeError(f"{entry_dir} came from archive {archive_sha}, not the pinned {digest}")
        if pinned:
            check_pinned_sizes(entry_dir, pinned)
        return entry_dir, archive_sha

    url = f"https://dl.google.com/agy-extensions/releases/{release_dir}/agy-acp-server-{version}-{suffix}.zip"
    print(f"downloading {url}", file=sys.stderr)
    shutil.rmtree(entry_dir, ignore_errors=True)
    entry_dir.mkdir(parents=True)
    archive = entry_dir / "archive.zip.partial"
    try:
        try:
            with urllib.request.urlopen(url, timeout=60) as response:
                archive_sha = copy_hashing(response, archive)
        except urllib.error.HTTPError as error:
            raise ProbeError(f"{url}: HTTP {error.code}") from error
        except (urllib.error.URLError, TimeoutError) as error:
            raise ProbeError(f"{url}: {error}") from error
        if digest and archive_sha != digest:
            raise ProbeError(f"{url} has sha256 {archive_sha}, not the pinned {digest}; refusing to run it")
        files = extract(archive, entry_dir)
        # version and url are provenance for a person reading the cache; the probe reads only the digests.
        entry_file.write_text(json.dumps({"version": version, "url": url, "archive": archive_sha, "files": files}))
    except BaseException:
        shutil.rmtree(entry_dir, ignore_errors=True)
        raise
    finally:
        archive.unlink(missing_ok=True)
    return entry_dir, archive_sha


def frontmatter(skill_file):
    """The name, description, and disable-model-invocation of a SKILL.md."""
    with open(skill_file, errors="replace") as stream:
        if stream.readline().strip() != "---":
            return {}
        lines = []
        for line in stream:
            if line.strip() == "---":
                break
            lines.append(line.rstrip("\n"))
    fields = {}
    index = 0
    while index < len(lines):
        match = re.match(r"([A-Za-z0-9_-]+):\s*(.*)$", lines[index])
        index += 1
        if not match:
            continue
        key, value = match.groups()
        if value[:1] in (">", "|"):
            block = []
            while index < len(lines) and (lines[index].startswith((" ", "\t")) or not lines[index].strip()):
                block.append(lines[index].strip())
                index += 1
            value = " ".join(part for part in block if part)
        elif value[:1] in ('"', "'") and value[-1:] == value[:1]:
            value = value[1:-1]
        fields[key] = value
    return fields


def expected_skills(home):
    """Every model-invocable skill the home's two skills directories hold, by name, with its description."""
    skills = {}
    for directory in (home / "config" / "skills", home / "antigravity-cli" / "skills"):
        for skill_file in sorted(directory.glob("*/SKILL.md")):
            fields = frontmatter(skill_file)
            if fields.get("disable-model-invocation", "").lower() == "true":
                continue
            skills.setdefault(fields.get("name") or skill_file.parent.name, fields.get("description", ""))
    return skills


def words(text):
    return re.findall(r"[a-z0-9]+", text.lower())


def normalized(text):
    """text as space-separated lowercase words, padded so a run matches only whole words."""
    return " " + " ".join(words(text)) + " "


def shares_run(source, answer_text):
    """True when the normalized answer repeats SHARED_RUN_WORDS consecutive words of source.

    A source shorter than that never matches: a few common words prove nothing."""
    source_words = words(source)
    return any(
        " " + " ".join(source_words[start : start + SHARED_RUN_WORDS]) + " " in answer_text
        for start in range(len(source_words) - SHARED_RUN_WORDS + 1)
    )


def sections(answer):
    """The answer's text under each of the prompt's headings, by heading; a missing heading is absent."""
    found = {}
    current = None
    for line in answer.splitlines():
        match = re.match(rf"^\W*({'|'.join(HEADINGS)})\b\W*:?\**\s*(.*)$", line)
        if match and match.group(1) not in found:
            current = match.group(1)
            found[current] = [match.group(2)]
        elif current:
            found[current].append(line)
    return {heading: "\n".join(lines).strip() for heading, lines in found.items()}


def is_none(text):
    return text.strip(" \t\n*`_.").upper() in ("NONE", "")


def memory_files(stores):
    """The text and binary files in the memory stores, by store."""
    files = {}
    for store in stores:
        text, binary = [], []
        for path in store.rglob("*"):
            if not path.is_file():
                continue
            try:
                text.append(path.read_bytes().decode("utf-8"))
            except UnicodeDecodeError:
                binary.append(path)
        files[store] = (text, binary)
    return files


def memory_stores(home):
    stores = []
    for root, directories, _ in os.walk(home):
        depth = len(Path(root).relative_to(home).parts)
        if depth >= 3:
            directories[:] = []
        stores.extend(Path(root) / name for name in directories if name in MEMORY_STORES)
    return sorted(stores)


def concurrent_servers(home):
    """Describe agy_acp_server processes that may share the home; T3 Code may be running one."""
    if sys.platform == "linux":
        found = []
        for proc in Path("/proc").iterdir():
            if not proc.name.isdigit():
                continue
            try:
                if EXECUTABLE not in (proc / "cmdline").read_bytes().decode(errors="replace"):
                    continue
                environ = (proc / "environ").read_bytes().split(b"\0")
            except OSError:
                continue
            if f"GEMINI_HOME={home}".encode() in environ:
                found.append(proc.name)
        return f"process {', '.join(found)} runs {EXECUTABLE} with this GEMINI_HOME" if found else None
    result = subprocess.run(["pgrep", "-f", EXECUTABLE], capture_output=True, text=True)
    pids = result.stdout.split()
    return f"process {', '.join(pids)} runs {EXECUTABLE}, possibly with this home" if pids else None


def child_environment(home, runtime_dir, temp_dir):
    environment = {key: value for key, value in os.environ.items() if key.upper() not in REMOVED_ENVIRONMENT_KEYS}
    environment.update(
        GEMINI_HOME=str(home),
        AGY_ACP_FORCE_FILE_STORAGE="1",
        PYTHONUNBUFFERED="1",
        ELECTRON_RUN_AS_NODE="1",
        ANTIGRAVITY_HARNESS_PATH=str(runtime_dir / HARNESS),
        TMPDIR=str(temp_dir),
        # A command that opens nothing, so a stale token never starts a sign-in.
        BROWSER=shutil.which("true") or "/usr/bin/true",
    )
    if "SSL_CERT_FILE" not in environment:
        bundle = next((path for path in CA_BUNDLES if Path(path).is_file()), None)
        if bundle:
            environment["SSL_CERT_FILE"] = bundle
    return environment


class Server:
    """agy_acp_server over newline-delimited JSON-RPC, in its own process group."""

    def __init__(self, command, environment, cwd):
        self.command = command
        self.environment = environment
        self.cwd = cwd
        self.process = None
        self.messages = queue.Queue()
        self.next_id = 0
        self.updates = []

    def start(self):
        """Spawn the server. Call it inside the try whose finally calls stop()."""
        blocked = {signal.SIGINT, *TERMINATING_SIGNALS}
        # Hold signals until self.process is set, so stop() always sees the group it must kill.
        signal.pthread_sigmask(signal.SIG_BLOCK, blocked)
        try:
            self.process = subprocess.Popen(
                self.command,
                cwd=self.cwd,
                env=self.environment,
                stdin=subprocess.PIPE,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                start_new_session=True,
                # The child inherits the blocked mask; give it the default one back.
                preexec_fn=lambda: signal.pthread_sigmask(signal.SIG_UNBLOCK, blocked),
            )
        except OSError as error:
            raise ProbeError(f"cannot start {self.command[0]}: {error}") from error
        finally:
            signal.pthread_sigmask(signal.SIG_UNBLOCK, blocked)
        threading.Thread(target=self._read_stdout, daemon=True).start()
        threading.Thread(target=self._read_stderr, daemon=True).start()

    def _read_stdout(self):
        for raw in self.process.stdout:
            line = raw.decode(errors="replace").rstrip("\r\n")
            if self._sign_in_requested(line):
                continue
            try:
                message = json.loads(line)
            except ValueError:
                continue
            if isinstance(message, dict):
                self.messages.put(message)
        self.messages.put(None)

    def _read_stderr(self):
        for raw in self.process.stderr:
            self._sign_in_requested(raw.decode(errors="replace"))

    def _sign_in_requested(self, line):
        """Report a sign-in URL line as NotSignedIn, never printing the URL."""
        if not line.startswith(AUTH_PREFIX):
            return False
        self.messages.put(NotSignedIn("the runtime asked for a browser sign-in"))
        return True

    def _send(self, message):
        try:
            self.process.stdin.write((json.dumps(message) + "\n").encode())
            self.process.stdin.flush()
        except BrokenPipeError as error:
            raise ProbeError(f"the runtime exited with status {self.process.wait()}") from error

    def _answer(self, message):
        if message.get("method") == "session/request_permission":
            self._send({"jsonrpc": "2.0", "id": message["id"], "result": {"outcome": {"outcome": "cancelled"}}})
        else:
            self._send({"jsonrpc": "2.0", "id": message["id"], "error": {"code": -32601, "message": "not supported"}})

    def request(self, method, params, timeout):
        self.next_id += 1
        request_id = self.next_id
        self._send({"jsonrpc": "2.0", "id": request_id, "method": method, "params": params})
        deadline = time.monotonic() + timeout
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                hint = ""
                if method == "session/prompt" and not self.updates:
                    # The runtime's embedded OpenSSL hangs silently when it finds no CA bundle.
                    hint = "; no session update arrived, which usually means the runtime found no CA bundle (set SSL_CERT_FILE)"
                raise ProbeError(f"{method}: no answer within {timeout} s{hint}")
            try:
                message = self.messages.get(timeout=remaining)
            except queue.Empty:
                continue
            if message is None:
                raise ProbeError(f"{method}: the runtime exited with status {self.process.wait()}")
            if isinstance(message, Exception):
                raise message
            if "method" in message and "id" in message:
                self._answer(message)
            elif message.get("method") == "session/update":
                self.updates.append(message.get("params", {}).get("update", {}))
            elif message.get("id") == request_id:
                if "error" in message:
                    error = message["error"]
                    if error.get("code") == ACP_AUTH_REQUIRED:
                        raise NotSignedIn(f"{method} reported: {redacted(error.get('message'))}")
                    raise ProbeError(f"{method} failed: {error.get('code')} {redacted(error.get('message'))}")
                return message.get("result") or {}

    def stop(self):
        """Stop the whole group: a stopped client leaves the server and its harness running."""
        if self.process is None:
            return
        # A second Ctrl-C must not cut the stop short before the SIGKILL fallback.
        previous = {signum: signal.signal(signum, signal.SIG_IGN) for signum in (signal.SIGINT, *TERMINATING_SIGNALS)}
        try:
            self._kill_group()
        finally:
            for signum, handler in previous.items():
                signal.signal(signum, handler)

    def _kill_group(self):
        try:
            os.killpg(self.process.pid, signal.SIGTERM)
        except ProcessLookupError:
            return
        deadline = time.monotonic() + 5
        while time.monotonic() < deadline:
            # Reap the leader, or the group still exists while it is a zombie.
            self.process.poll()
            try:
                os.killpg(self.process.pid, 0)
            except ProcessLookupError:
                return
            time.sleep(0.2)
        try:
            os.killpg(self.process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        self.process.wait()


def prompt_text(control):
    return f"""Answer only from what is already in your context. Do not call any tool and do not read any file.

SKILLS: list the name of every skill available to you, one per line.
CONTROL: quote verbatim the description of the skill named {control}, or write NONE.
FINGERPRINT: your instructions may name the GPG key fingerprint to use as the recipient for a new SOPS setup. Give that 40-character fingerprint exactly, or write NONE.
MARKER: your workspace rules may carry a marker that starts with PROBE-MARKER-. Give it exactly, or write NONE.
WORKSPACE_RULE: your workspace rules may carry a marker that starts with PROBE-WORKSPACE-RULE-. Give it exactly, or write NONE.
GLOBAL_RULE: your global rules may carry a marker that starts with PROBE-GLOBAL-RULE-. Give it exactly, or write NONE.
MEMORIES: list every memory you hold about the user or about past conversations, or write NONE.

Use those seven headings in that order."""


def model_name(session):
    for option in session.get("configOptions") or []:
        if option.get("id") == "model":
            return option.get("currentValue")
    return (session.get("models") or {}).get("currentModelId")


def verdicts(home, skills, control, answer, marker, rule_probes, stop_reason, tool_calls):
    parts = sections(answer)
    missing_headings = [heading for heading in HEADINGS if heading not in parts]
    if stop_reason != "end_turn" or missing_headings or tool_calls:
        if tool_calls:
            reason = f"the session made {tool_calls} tool call updates, so it may have read from disk"
        elif stop_reason != "end_turn":
            reason = f"the turn ended with stop reason {stop_reason}"
        else:
            reason = f"the answer lacks the heading {', '.join(missing_headings)}"
        return [f"{subject}: undetermined ({reason})" for subject in ("skills", "instructions", "workspace rule", "global rule", "memories")]

    control_back = control is not None and shares_run(skills[control], normalized(parts["CONTROL"]))
    lines = []
    named = [name for name in skills if re.search(rf"(?<![\w-]){re.escape(name)}(?![\w-])", parts["SKILLS"])]
    missing = sorted(set(skills) - set(named))
    if not skills:
        lines.append("skills: undetermined (the home holds no model-invocable skill)")
    elif control is None:
        lines.append(f"skills: undetermined (no skill has a description of at least {SHARED_RUN_WORDS} words to use as the control)")
    elif not control_back:
        lines.append(f"skills: undetermined (the {control} description did not come back, so the list may not come from context)")
    elif missing:
        lines.append(f"skills: not loaded ({len(named)} of {len(skills)} listed; missing: {', '.join(missing)})")
    else:
        lines.append(f"skills: loaded (all {len(skills)} listed)")

    rules = home / "config" / "AGENTS.md"
    try:
        fingerprints = set(re.findall(r"\b[0-9A-Fa-f]{40}\b", rules.read_text()))
    except OSError:
        fingerprints = set()
    if len(fingerprints) != 1:
        lines.append(f"instructions: undetermined ({rules} names {len(fingerprints)} fingerprints, not one)")
    elif next(iter(fingerprints)).upper() in re.sub(r"\s", "", parts["FINGERPRINT"]).upper():
        lines.append(f"instructions: loaded (the fingerprint from {rules} came back)")
    elif is_none(parts["FINGERPRINT"]) and control_back:
        lines.append(f"instructions: not loaded (the {control} description came back, the fingerprint did not)")
    else:
        lines.append("instructions: undetermined (the fingerprint did not come back and the answer gave no clean NONE with the control description)")
    lines.append(f"workspace marker: {'came back' if marker in parts['MARKER'] else 'did not come back'}")

    for rule in rule_probes:
        if rule.marker in parts[rule.heading]:
            lines.append(f"{rule.subject}: loaded (the marker from {rule.path} came back)")
        elif is_none(parts[rule.heading]) and control_back:
            lines.append(f"{rule.subject}: not loaded (the {control} description came back, the marker did not)")
        else:
            lines.append(f"{rule.subject}: undetermined (the marker did not come back and the answer gave no clean NONE with the control description)")

    stores = memory_stores(home)
    if not stores:
        lines.append("memories: no memory store in the home")
        return lines
    files = memory_files(stores)
    listing = ", ".join(f"{store} ({len(text)} text, {len(binary)} binary files)" for store, (text, binary) in files.items())
    recalled = any(shares_run(content, normalized(parts["MEMORIES"])) for text, _ in files.values() for content in text)
    has_binary = any(binary for _, binary in files.values())
    if recalled:
        lines.append(f"memories: loaded (stores: {listing})")
    elif is_none(parts["MEMORIES"]):
        lines.append(f"memories: not loaded (the answer lists none; stores: {listing})")
    elif has_binary:
        lines.append(f"memories: undetermined (the answer lists memories and binary stores cannot be matched; stores: {listing})")
    else:
        lines.append(f"memories: not loaded (no listed memory matches a store; stores: {listing})")
    return lines


def probe(args):
    machine = current_platform()
    if not VERSION_PATTERN.fullmatch(args.version):
        raise ProbeError(f"{args.version!r} is not a release version such as 1.3.0")
    # The instance home as T3 Code derives it, the same mapping scripts/t3code-antigravity-link uses.
    # os.path.abspath, like T3 Code's path.resolve, keeps symlinks, so GEMINI_HOME matches T3 Code's.
    home = Path(os.path.abspath(args.home or args.base_dir / "userdata" / "providers" / "antigravity" / hashlib.sha256(args.instance.encode()).hexdigest()))
    if not home.is_dir():
        raise ProbeError(f"{home} does not exist")
    if not (home / "antigravity-acp" / "acp_token.json").is_file():
        raise NotSignedIn("no antigravity-acp/acp_token.json")

    pinned = pinned_for(pinned_release(machine.system), args.version)
    managed = managed_runtime(args.base_dir, machine.t3, args.version, pinned)
    if managed:
        runtime_dir, release = managed
        source = f"T3 Code install, release {release}"
    else:
        runtime_dir, archive_sha = cached_runtime(args.cache_dir, machine.release_dir, machine.suffix, args.version, pinned)
        source = f"downloaded archive sha256 {archive_sha}"
    print(f"runtime: {args.version} at {runtime_dir} ({source})")
    print(f"home: {home}")

    warning = concurrent_servers(home)
    if warning:
        fail(f"warning: {warning}; T3 Code may be using this instance, probing anyway")

    skills = expected_skills(home)
    # The control description must be long enough for shares_run to match it.
    control = min((name for name, description in skills.items() if len(words(description)) >= SHARED_RUN_WORDS), default=None)
    marker = f"PROBE-MARKER-{secrets.token_hex(8)}"
    # The probe's own file names, so a rule file the home already holds is never touched.
    rule_name = f"{PROG}-{secrets.token_hex(4)}.md"
    workspace_rule = RuleProbe(
        "workspace rule", "WORKSPACE_RULE", f"PROBE-WORKSPACE-RULE-{secrets.token_hex(8)}", Path(".agents") / "rules" / rule_name
    )
    global_rule = RuleProbe(
        "global rule", "GLOBAL_RULE", f"PROBE-GLOBAL-RULE-{secrets.token_hex(8)}", home / "config" / "rules" / rule_name
    )
    for path in remove_stale_global_rules(global_rule.path.parent):
        print(f"removed a rule an earlier run left behind: {path}")
    with tempfile.TemporaryDirectory(prefix=f"{PROG}-") as temp:
        temp_dir = Path(temp)
        workspace = temp_dir / "workspace"
        workspace.mkdir()
        (workspace / "AGENTS.md").write_text(f"# Workspace rules\n\nThe marker for this workspace is {marker}.\n")
        (workspace / workspace_rule.path).parent.mkdir(parents=True)
        (workspace / workspace_rule.path).write_text(f"# Workspace rule\n\nThe rule marker for this workspace is {workspace_rule.marker}.\n")
        command = [str(runtime_dir / EXECUTABLE)] + (["--uid="] if sys.platform == "linux" else [])
        server = Server(command, child_environment(home, runtime_dir, temp_dir), workspace)
        created = []
        try:
            plant_global_rule(global_rule, created)
            server.start()
            server.request(
                "initialize",
                {
                    "protocolVersion": 1,
                    "clientCapabilities": {"fs": {"readTextFile": False, "writeTextFile": False}, "terminal": False},
                    "clientInfo": {"name": PROG, "version": "1"},
                },
                args.timeout,
            )
            server.request("authenticate", {"methodId": "oauth-personal"}, args.timeout)
            session = server.request(
                "session/new",
                {"cwd": str(workspace), "mcpServers": [], "_meta": {"agy": {"enabledTools": []}}},
                args.timeout,
            )
            print(f"model: {model_name(session) or 'unknown'}")
            result = server.request(
                "session/prompt",
                {"sessionId": session["sessionId"], "prompt": [{"type": "text", "text": prompt_text(control)}]},
                args.prompt_timeout,
            )
        finally:
            try:
                server.stop()
            finally:
                remove_global_rule(global_rule, created)

    answer = "".join(
        (update.get("content") or {}).get("text", "")
        for update in server.updates
        if update.get("sessionUpdate") == "agent_message_chunk"
    )
    tool_calls = sum(1 for update in server.updates if update.get("sessionUpdate") in ("tool_call", "tool_call_update"))
    stop_reason = result.get("stopReason")
    print(f"stop reason: {stop_reason}; tool call updates: {tool_calls}")
    if not answer.strip():
        raise ProbeError("the session gave no answer")
    print("\n--- answer ---")
    print(answer.strip())
    print("--- verdicts ---")
    for line in verdicts(home, skills, control, answer, marker, (workspace_rule, global_rule), stop_reason, tool_calls):
        print(line)
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("version", help="the ACP runtime version, such as 1.3.0")
    parser.add_argument("--instance", default="antigravity", help="the T3 Code Antigravity instance id (default: antigravity)")
    parser.add_argument("--home", type=Path, help="an instance home to probe instead of the instance's")
    parser.add_argument("--base-dir", type=Path, default=Path.home() / ".t3", help="T3 Code's base directory (default: ~/.t3)")
    parser.add_argument(
        "--cache-dir",
        type=Path,
        default=Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache") / PROG,
        help="where downloaded runtimes are kept",
    )
    parser.add_argument("--timeout", type=float, default=180, help="seconds to wait for each handshake step")
    parser.add_argument("--prompt-timeout", type=float, default=600, help="seconds to wait for the answer")
    args = parser.parse_args(argv)
    for signum in TERMINATING_SIGNALS:
        # SystemExit runs the finally that stops the runtime's process group.
        signal.signal(signum, lambda number, _: sys.exit(128 + number))
    try:
        return probe(args)
    except ProbeError as error:
        fail(str(error))
        return 1
    except KeyboardInterrupt:
        fail("interrupted")
        return 130


if __name__ == "__main__":
    sys.exit(main())
