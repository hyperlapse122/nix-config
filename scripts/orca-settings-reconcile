#!/usr/bin/env python3
"""Reconcile declared settings leaves into Orca's live orca-data.json profile.

Orca IDE mixes declared application settings with dynamic session state, worktree
metadata, and telemetry in ~/.config/orca/profiles/<activeProfileId>/orca-data.json.
While running, Orca holds this document in memory and periodically rewrites it to
disk (roughly every 9 seconds), ignoring external modifications.

This script safely updates only the declared JSON leaf paths when Orca is not running,
and inspects the SingletonLock symlink to detect live instances and avoid write races.
"""
import argparse
import json
import os
from pathlib import Path
import sys
import tempfile


def check_orca_running(config_dir):
    """Check if Orca is running by inspecting SingletonLock."""
    lock = config_dir / "SingletonLock"
    try:
        target = os.readlink(lock)
    except OSError:
        return False, None

    # Target format: <hostname>-<pid>. Hostname may contain hyphens.
    if "-" not in target:
        return False, None

    host, pid_str = target.rsplit("-", 1)
    if not pid_str.isdigit():
        return False, None

    current_host = os.uname().nodename
    if host != current_host:
        return False, None

    pid = int(pid_str)
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False, pid
    except PermissionError:
        return False, pid
    except OSError:
        return False, None

    # Avoid false positives from recycled PIDs after system crash or reboot.
    # Check if the process name or cmdline actually references orca.
    try:
        cmdline_file = Path(f"/proc/{pid}/cmdline")
        if cmdline_file.exists():
            cmdline = cmdline_file.read_text(encoding="utf-8", errors="ignore").lower()
            if "orca" not in cmdline:
                return False, pid
    except (OSError, PermissionError):
        pass

    return True, pid


def get_leaf(doc, path_parts):
    """Retrieve value at dotted path parts. Returns (found, value)."""
    curr = doc
    for part in path_parts:
        if not isinstance(curr, dict) or part not in curr:
            return False, None
        curr = curr[part]
    return True, curr


def set_leaf(doc, path_parts, value):
    """Set value at dotted path parts, creating intermediate dicts if needed."""
    curr = doc
    for part in path_parts[:-1]:
        if part not in curr or not isinstance(curr[part], dict):
            curr[part] = {}
        curr = curr[part]
    curr[path_parts[-1]] = value


def reconcile(config_dir, declared_file, mode="assert"):
    index_file = config_dir / "orca-profile-index.json"
    if not index_file.is_file():
        print(
            f"orca-settings-reconcile: {index_file} is missing (Orca has not run on this host); nothing to reconcile.",
            file=sys.stderr,
        )
        return 0

    try:
        index_data = json.loads(index_file.read_text(encoding="utf-8"))
    except Exception as e:
        print(f"orca-settings-reconcile: Failed to parse {index_file}: {e}", file=sys.stderr)
        return 0

    if not isinstance(index_data, dict):
        print(f"orca-settings-reconcile: {index_file} is not a JSON object; skipping.", file=sys.stderr)
        return 0

    active_profile = index_data.get("activeProfileId")
    if not active_profile or not isinstance(active_profile, str):
        print(f"orca-settings-reconcile: {index_file} names no activeProfileId; skipping.", file=sys.stderr)
        return 0

    data_file = config_dir / "profiles" / active_profile / "orca-data.json"
    if not data_file.is_file():
        print(f"orca-settings-reconcile: {data_file} is missing; skipping.", file=sys.stderr)
        return 0

    is_running, pid = check_orca_running(config_dir)
    if is_running:
        if mode == "assert":
            print(
                f"orca-settings-reconcile: Orca is currently running (pid {pid}); skipping write to avoid overwriting active session.",
                file=sys.stderr,
            )
            return 0
        else:
            print(f"orca-settings-reconcile: Orca is currently running (pid {pid}).", file=sys.stderr)

    try:
        declared = json.loads(declared_file.read_text(encoding="utf-8"))
    except Exception as e:
        print(f"orca-settings-reconcile: Failed to parse declared settings {declared_file}: {e}", file=sys.stderr)
        return 1

    if not isinstance(declared, dict):
        print(f"orca-settings-reconcile: Declared settings in {declared_file} must be a JSON object.", file=sys.stderr)
        return 1

    try:
        current_data = json.loads(data_file.read_text(encoding="utf-8"))
    except Exception as e:
        print(f"orca-settings-reconcile: Failed to parse {data_file}: {e}", file=sys.stderr)
        return 0

    if not isinstance(current_data, dict):
        print(f"orca-settings-reconcile: {data_file} is not a JSON object; skipping.", file=sys.stderr)
        return 0

    drifted_leaves = []
    for path_str, declared_val in declared.items():
        parts = path_str.split(".")
        found, current_val = get_leaf(current_data, parts)
        if not found or current_val != declared_val:
            drifted_leaves.append((parts, declared_val))
            if mode == "report":
                print(f"drift\t{path_str}")
        elif mode == "report":
            print(f"converged\t{path_str}")

    if mode == "report" or not drifted_leaves:
        return 0

    for parts, declared_val in drifted_leaves:
        set_leaf(current_data, parts, declared_val)

    profile_dir = data_file.parent
    temp_fd, temp_path = tempfile.mkstemp(prefix=".orca-data-", dir=profile_dir)
    try:
        with os.fdopen(temp_fd, "w", encoding="utf-8") as stream:
            json.dump(current_data, stream, indent=2, ensure_ascii=False)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temp_path, 0o600)
        os.replace(temp_path, data_file)
    finally:
        try:
            os.unlink(temp_path)
        except OSError:
            pass

    print(
        f"orca-settings-reconcile: Converged {len(drifted_leaves)} declared setting(s) into {data_file.name}.",
        file=sys.stderr,
    )
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--mode",
        choices=["assert", "report"],
        default="assert",
        help="Reconciliation mode: assert (default) or report",
    )
    parser.add_argument(
        "--declared",
        required=True,
        type=Path,
        help="Path to JSON file with declared settings leaves",
    )
    parser.add_argument(
        "--config-dir",
        type=Path,
        default=Path.home() / ".config" / "orca",
        help="Path to Orca configuration directory (default: ~/.config/orca)",
    )
    args = parser.parse_args(argv)

    return reconcile(args.config_dir, args.declared, mode=args.mode)


if __name__ == "__main__":
    sys.exit(main())
