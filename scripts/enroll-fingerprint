#!/usr/bin/env bash
# Enroll a fingerprint for the invoking user. The Nix package replaces the
# @...@ constants with absolute store paths.
#
# Enrolling through this helper costs the account password. polkit authenticates
# every action through the single polkit-1 PAM stack, which this system
# deliberately gives the fingerprint factor, so upstream fprintd's
# auth_self_keep enroll action would otherwise let one swipe mint another
# finger. modules/nixos/hardware/fingerprint.nix closes that action to non-root and
# declares the fingerprint-free enroll-fingerprint PAM service this script
# authenticates against instead.
#
# What that does NOT buy: the fingerprint reaches sudo on this host, so it
# reaches root, and root may enroll directly. This helper and that polkit rule
# close the unprivileged path, not the privileged one. Treat them as the
# sanctioned route and as a guard against accident, never as a boundary against
# someone who already has a finger the sensor accepts.
#
# Every external command is a build-time constant with no environment
# fallback. The test renders its own copy of this file to stub them, the way
# tests/nr.sh does, so the installed helper carries store paths that nothing in
# the environment can displace -- an override on the authenticator would be the
# bypass the password demand exists to prevent, and an override on the
# escalation target would be a root-shell primitive waiting for a NOPASSWD
# entry or a setuid wrapper to make it live.
set -euo pipefail

PAMTESTER="@PAMTESTER@"
PAM_SERVICE=enroll-fingerprint

FPRINTD_ENROLL="@FPRINTD_ENROLL@"
FPRINTD_LIST="@FPRINTD_LIST@"
SUDO="@SUDO@"

# Exit codes beyond the usual 1 (error) and 2 (usage).
EXIT_NO_READER=3
EXIT_CAPTURE_FAILED=4

die() {
  printf 'enroll-fingerprint: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat >&2 <<'USAGE'
usage: enroll-fingerprint [--finger NAME]

  --finger NAME  which finger to enroll (default: right-index-finger)

Authorized by the account password. Run it unprivileged; it escalates itself.
USAGE
}

if [[ $(id -u) -eq 0 ]]; then
  die 'must not run as root; the invoking user is who gets enrolled, and running'\
' as root would enroll a finger for root instead'
fi

finger=right-index-finger
while [[ $# -gt 0 ]]; do
  case $1 in
    --finger)
      [[ $# -ge 2 ]] || die 'missing value for --finger'
      finger=$2
      shift 2
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      printf 'enroll-fingerprint: unknown argument %s\n' "$1" >&2
      usage
      exit 2
      ;;
  esac
done

user=$(id -un)

# The reader is checked before the password is asked for: being told to type a
# password and only then that the hardware is missing wastes the one thing the
# user actually has to do by hand.
if ! "$FPRINTD_LIST" "$user" >/dev/null 2>&1; then
  printf 'enroll-fingerprint: no fingerprint reader is available\n' >&2
  exit "$EXIT_NO_READER"
fi

# Re-enrolling a named finger replaces it rather than adding a second record;
# say so, because fprintd is silent about it and the two readings differ.
if "$FPRINTD_LIST" "$user" 2>/dev/null | grep -qF -- "$finger"; then
  printf 'enroll-fingerprint: %s is already enrolled; it will be replaced\n' "$finger" >&2
fi

printf 'enroll-fingerprint: authorizing with your account password\n' >&2
"$PAMTESTER" "$PAM_SERVICE" "$user" authenticate ||
  die 'password authentication failed; nothing was enrolled'

if ! "$SUDO" -- "$FPRINTD_ENROLL" -f "$finger" "$user"; then
  printf 'enroll-fingerprint: capturing %s failed; nothing was enrolled\n' "$finger" >&2
  exit "$EXIT_CAPTURE_FAILED"
fi

printf 'enroll-fingerprint: enrolled %s for %s\n' "$finger" "$user"
